# Zkopíruj na .env a doplň hodnoty.
#   cp .env.example .env

# === Required =============================================================
OPENAI_API_KEY=sk-...

# === Frontend (jen pro lokální dev mimo docker-compose) ===================
# Uvnitř docker-compose se backend resolvuje přes service DNS jako "backend".
# Pro lokální dev nastav na http://localhost:8000.
API_URL=http://backend:8000

