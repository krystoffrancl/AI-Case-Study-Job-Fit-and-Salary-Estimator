# Zkopíruj na .env a doplň hodnoty.
#   cp .env.example .env

# === Required =============================================================
OPENAI_API_KEY=sk-...

# === Frontend (jen pro lokální dev mimo docker-compose) ===================
# Uvnitř docker-compose se backend resolvuje přes service DNS jako "backend".
# Pro lokální dev nastav na http://localhost:8000.
API_URL=http://backend:8000

# === Optional: model overrides ============================================
# EXTRACTION_MODEL=gpt-4.1-nano
# FINALIZER_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# JUDGE_MODEL=gpt-4.1-mini

# === Optional: tuning =====================================================
# EXTRACTION_TEMPERATURE=0.0
# FINALIZER_TEMPERATURE=0.2
# MAX_FILE_SIZE_MB=10
# EMBEDDING_TOPK=3
# GROWTH_MULTIPLIER=1.30
# ANCHOR_DRIFT_PCT=0.10
# USD_TO_CZK=23.0
